// Structure to represent a weighted edge in the graph
typedef struct {
    int u;
    int v;
    int w;
} Edge;

// Recursive helper function to print the path from source to current vertex
void printPath(int parent[], int v) {
    if (parent[v] == -1) {
        printf("%d", v);
        return;
    }
    printPath(parent, parent[v]);
    printf("->%d", v);
}

