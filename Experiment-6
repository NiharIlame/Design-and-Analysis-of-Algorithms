        } else {
            distance[i] = INFINITY;
            pred[i] = 0;
        }
    }

    visited[startnode] = 1;
    count = 1;

    while (count < n) {
        mindistance = INFINITY;

        for (i = 1; i <= n; i++) {
            if (distance[i] < mindistance && !visited[i]) {
                mindistance = distance[i];
                nextnode = i;
            }
        }

        if (mindistance == INFINITY) {
            break;
        }

        visited[nextnode] = 1;
        for (i = 1; i <= n; i++) {
            int edge_weight = G[nextnode][i];
            if (edge_weight == 0 && nextnode != i) {
                edge_weight = INFINITY;
            }

            if (!visited[i] && edge_weight > 0 && edge_weight != INFINITY) {
                if (mindistance + edge_weight < distance[i]) {
                    distance[i] = mindistance + edge_weight;
