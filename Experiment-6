    for (i = 1; i <= n; i++) {
        visited[i] = 0;
        if (i == startnode) {
            distance[i] = 0;
            pred[i] = startnode;
        } else if (G[startnode][i] > 0 && G[startnode][i] != INFINITY) {
            distance[i] = G[startnode][i];
